# ---------------------------------------------------------------------------
# WebMCP Forge — environment contract
#
# Copy to `.env.local` and fill in real values. `.env.local` is git-ignored and
# must never be committed. Every variable below is SERVER-ONLY: none of them are
# prefixed with NEXT_PUBLIC_, and none of them are readable from the browser.
# ---------------------------------------------------------------------------

# --- Database (Supabase Postgres, used purely as hosted Postgres) ------------
# DATABASE_URL is used by the application at runtime, through the Prisma
# PostgreSQL driver adapter. Point it at the Supabase transaction pooler.
DATABASE_URL="postgresql://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL is used by the Prisma CLI for `migrate` / `db` commands, which need
# a session-mode (non-pooled) connection.
DIRECT_URL="postgresql://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Google Gemini ----------------------------------------------------------
# Used only during scanning / semantic mapping and the optional natural-language
# demo. It is NEVER used while an installed portfolio executes a WebMCP tool.
GEMINI_API_KEY="your-gemini-api-key"

# Semantic-mapping model chain. Tried in order; see docs/README for the exact
# retry and fallback rules.
GEMINI_SEMANTIC_PRIMARY_MODEL="gemini-3.7-flash"
GEMINI_SEMANTIC_FALLBACK_1_MODEL="gemini-3.5-flash-lite"
GEMINI_SEMANTIC_FALLBACK_2_MODEL="gemini-3.1-flash-lite"

# The natural-language chain. Exactly two cheap models, kept separate from the
# semantic scan chain above: this path is interactive, so it must stay fast and
# must never reach for the flagship model.
GEMINI_NL_DEMO_PRIMARY_MODEL="gemini-3.5-flash-lite"
GEMINI_NL_DEMO_FALLBACK_MODEL="gemini-3.1-flash-lite"

# Interactive budget per attempt. Much shorter than the scan timeout.
GEMINI_NL_DEMO_TIMEOUT_MS=9000

# Legacy alias for GEMINI_NL_DEMO_PRIMARY_MODEL.
GEMINI_NL_DEMO_MODEL="gemini-3.5-flash-lite"

# Hard, server-enforced cap on natural-language demo questions per site.
GEMINI_NL_DEMO_MAX_QUESTIONS=3

# Per-model transient-failure retries (see §16 of the architecture).
GEMINI_MAX_RETRIES_PER_MODEL=1
GEMINI_REQUEST_TIMEOUT_MS=20000

# --- Application ------------------------------------------------------------
# Absolute origin this deployment is reachable at. Used to build the one-line
# installation <script> tag and the runtime's config endpoint.
APP_BASE_URL="http://localhost:3000"

# A portfolio first-time visitors can try with one click. Empty hides the button.
DEMO_PORTFOLIO_URL="https://webmcp-forge-demo-portfolio.vercel.app/"

# --- Scanner bounds ---------------------------------------------------------
SCAN_MAX_PAGES=10
SCAN_REQUEST_TIMEOUT_MS=10000
SCAN_MAX_HTML_BYTES=2000000
SCAN_MAX_REDIRECTS=3

# Wall-clock budgets, so a slow site cannot outlive the request.
SCAN_TIME_BUDGET_MS=25000
SCAN_AI_BUDGET_MS=30000

# Anti-abuse: how many scans one anonymous builder session may start per hour.
SCAN_MAX_PER_SESSION_PER_HOUR=10

# --- Visual scan assistance (EXPERIMENTAL, off by default) -------------------
# When a scan is structurally valid but semantically ambiguous, screenshots of
# the ambiguous sections can be attached to the SAME semantic Gemini call to
# help it choose. This requires a headless browser, which does NOT inherit the
# SSRF protections of the fetch path, so it ships disabled. Leave it false
# unless you have separately contained the renderer's network access.
VISUAL_SCAN_ENABLED=false
VISUAL_SCAN_MAX_IMAGES=3
VISUAL_SCAN_MAX_IMAGE_BYTES=600000
VISUAL_SCAN_MAX_TOTAL_IMAGE_BYTES=1500000

# --- Verification -----------------------------------------------------------
# Lifetime of a single-use installation-verification challenge.
VERIFICATION_CHALLENGE_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Deliberately NOT required, because WebMCP Forge does not use the Supabase
# Data API, Supabase Auth, or browser-side supabase-js:
#
#   NEXT_PUBLIC_SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY
#   SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY
#
# All database access is trusted server-side Prisma code.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Backwards-compatible aliases. If your .env.local predates the canonical names
# above, these older names are still accepted (canonical names win):
#
#   NEXT_PUBLIC_APP_URL          -> APP_BASE_URL
#   GEMINI_PRIMARY_MODEL         -> GEMINI_SEMANTIC_PRIMARY_MODEL
#   GEMINI_FALLBACK_MODEL_1      -> GEMINI_SEMANTIC_FALLBACK_1_MODEL
#   GEMINI_FALLBACK_MODEL_2      -> GEMINI_SEMANTIC_FALLBACK_2_MODEL
#   GEMINI_PREVIEW_MODEL         -> GEMINI_NL_DEMO_MODEL
#   GEMINI_NL_DEMO_MODEL         -> GEMINI_NL_DEMO_PRIMARY_MODEL
#   GEMINI_FALLBACK_MODEL_2      -> GEMINI_NL_DEMO_FALLBACK_MODEL
#   NATURAL_LANGUAGE_DEMO_LIMIT  -> GEMINI_NL_DEMO_MAX_QUESTIONS
# ---------------------------------------------------------------------------
