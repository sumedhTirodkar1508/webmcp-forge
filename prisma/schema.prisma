// WebMCP Forge — database schema.
//
// Supabase is used purely as hosted PostgreSQL. There is no Supabase Auth, no
// Data API and no browser-side database access: every read and write goes
// through trusted Next.js server code.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Ownership
// ---------------------------------------------------------------------------

/// An anonymous builder session. The raw bearer token lives only in an
/// HttpOnly cookie on the user's device; we store nothing but its SHA-256 hash,
/// so a database leak cannot be replayed as a session.
model BuilderSession {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  expiresAt  DateTime  @map("expires_at")

  sites        Site[]
  siteAccess   SiteAccess[]
  liveTests    LiveTestSession[]
  scanRuns     ScanRun[]

  @@index([expiresAt])
  @@map("builder_sessions")
}

// ---------------------------------------------------------------------------
// Sites
// ---------------------------------------------------------------------------

enum SiteStatus {
  DRAFT
  SCANNED
  CONFIGURED
  PUBLISHED

  @@map("site_status")
}

enum Platform {
  FRAMER
  WIX
  WEBFLOW
  SQUARESPACE
  NEXTJS
  CUSTOM
  UNKNOWN

  @@map("platform")
}

/// A portfolio being made agent-ready.
model Site {
  id String @id @default(uuid()) @db.Uuid

  /// Public, non-secret runtime identifier (`wmf_` + 24 base32 chars). It is
  /// embedded in the installation snippet, so it is not a credential — but it
  /// is random rather than sequential so sites cannot be enumerated.
  publicId String @unique @map("public_id")

  /// Which anonymous session first registered this origin. Attribution only —
  /// authorization lives in `accessGrants`.
  ///
  /// Nullable, and SET NULL rather than CASCADE, because a site must outlive
  /// the browser session that created it. A site's `public_id` is pasted into
  /// a real website; cascading its deletion off an expiring session row would
  /// silently kill a live installation.
  createdBySessionId String?         @map("created_by_session_id") @db.Uuid
  createdBySession   BuilderSession? @relation(fields: [createdBySessionId], references: [id], onDelete: SetNull)

  /// Reserved for the future Auth.js migration; always null in the MVP.
  ownerUserId String? @map("owner_user_id") @db.Uuid

  canonicalUrl String     @map("canonical_url")
  origin       String
  platform     Platform   @default(UNKNOWN)
  title        String?
  status       SiteStatus @default(DRAFT)

  /// LEGACY — retained to avoid a destructive migration; carries no authority.
  ///
  /// This once decided which configuration the public endpoint served. The
  /// ACTIVE configuration is now whichever version the website itself pins in
  /// `data-wmf-config`, because generating a configuration in Forge must never
  /// change what a live website executes.
  publishedConfigVersionId String?        @unique @map("published_config_version_id") @db.Uuid
  publishedConfigVersion   ConfigVersion? @relation("SitePublishedConfig", fields: [publishedConfigVersionId], references: [id], onDelete: SetNull)

  /// Capability settings the builder is currently editing.
  ///
  /// Toggling a capability used to append a whole ConfigVersion, so ordinary
  /// UI fiddling inflated the history and made "latest version" look
  /// meaningful. Versions are now append-only snapshots created only by an
  /// explicit generate action; the in-progress draft lives here.
  draftSettings Json? @map("draft_settings")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pages                 SitePage[]
  scanRuns              ScanRun[]
  configVersions        ConfigVersion[]        @relation("SiteConfigVersions")
  verificationChallenge VerificationChallenge[]
  verificationRuns      VerificationRun[]
  liveTestSessions      LiveTestSession[]
  aiUsageEvents         AiUsageEvent[]

  /// Browser sessions authorized to manage this site.
  accessGrants SiteAccess[]

  /// NOTE ON IDENTITY
  ///
  /// A site's identity is its ORIGIN — `public_id` is embedded permanently in
  /// someone's website, so it must not change when a cookie is cleared. The
  /// unique index that enforces that lives in a migration which is deliberately
  /// left unapplied while duplicate rows exist; see
  /// `20260903020000_site_identity_per_origin_global`.
  ///
  /// The older `@@unique([createdBySessionId, origin])` is what caused the
  /// duplicate: it made identity per-session, so a new anonymous session
  /// minted a second public id for a website Forge already knew about.
  /// Authorization now lives in `SiteAccess` instead, which is the thing that
  /// actually should be per-session.
  @@unique([origin])
  @@index([createdBySessionId])
  @@map("sites")
}

/// Which anonymous browser sessions may manage a site.
///
/// This is the piece that was previously conflated with identity. A website's
/// public id must be stable for the life of the website; permission to change
/// its configuration must not be. Separating them means clearing cookies costs
/// you authorization (recoverable) rather than rotating the installation id
/// embedded in the site (not recoverable without editing the site).
///
/// Access is never granted merely because someone typed a public URL — see
/// `resolveSiteForTarget` in `site-service.ts`.
model SiteAccess {
  id String @id @default(uuid()) @db.Uuid

  siteId String @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  builderSessionId String         @map("builder_session_id") @db.Uuid
  builderSession   BuilderSession @relation(fields: [builderSessionId], references: [id], onDelete: Cascade)

  /// How this session came to be authorized. `CREATED` is the session that
  /// first registered the origin; `DEV_REATTACH` is the local-development
  /// escape hatch and is impossible in production.
  grantedVia SiteAccessGrant @default(CREATED) @map("granted_via")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([siteId, builderSessionId])
  @@index([builderSessionId])
  @@map("site_access")
}

enum SiteAccessGrant {
  CREATED
  DEV_REATTACH

  @@map("site_access_grant")
}

enum PageType {
  HOME
  ABOUT
  WORK_INDEX
  PROJECT_DETAIL
  EXPERIENCE
  EDUCATION
  CONTACT
  BLOG
  OTHER

  @@map("page_type")
}

/// One page discovered by the crawler.
model SitePage {
  id     String @id @default(uuid()) @db.Uuid
  siteId String @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  url      String
  pathname String

  /// Normalised route shape, e.g. `/work/*`. Lets one configuration apply to
  /// every project detail page without listing them individually.
  routePattern String?  @map("route_pattern")
  pageType     PageType @default(OTHER) @map("page_type")

  httpStatus  Int?    @map("http_status")
  contentType String? @map("content_type")
  byteSize    Int?    @map("byte_size")
  title       String?

  /// True when the server-returned HTML carried almost no readable content —
  /// the signature of a client-rendered site.
  lowInformation Boolean @default(false) @map("low_information")

  fetchedAt DateTime @default(now()) @map("fetched_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([siteId, url])
  @@index([siteId, routePattern])
  @@map("site_pages")
}

// ---------------------------------------------------------------------------
// Scanning
// ---------------------------------------------------------------------------

enum ScanStatus {
  PENDING
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED

  @@map("scan_status")
}

model ScanRun {
  id     String @id @default(uuid()) @db.Uuid
  siteId String @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  /// The browser session that started this scan. The hourly scan limit counts
  /// by this, not by who first registered the site: a site is permanent per
  /// origin, so "sites this session created" is nothing at all for a visitor
  /// scanning an origin someone else registered first. Null on older rows.
  sessionId String?         @map("session_id") @db.Uuid
  session   BuilderSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  status       ScanStatus @default(PENDING)
  pagesScanned Int        @default(0) @map("pages_scanned")
  pagesFailed  Int        @default(0) @map("pages_failed")

  /// Compact deterministic extraction, before any AI involvement.
  deterministic Json?

  /// Gemini's semantic interpretation, after Zod validation.
  semantic Json?

  /// Which model produced `semantic`, and whether a fallback was needed.
  semanticModel     String?  @map("semantic_model")
  semanticAttempts  Int      @default(0) @map("semantic_attempts")
  semanticFellBack  Boolean  @default(false) @map("semantic_fell_back")

  /// Non-fatal problems worth showing the user (blocked pages, timeouts, ...).
  warnings Json?

  /// User-safe failure summary. Never contains a stack trace.
  errorCode    String? @map("error_code")
  errorMessage String? @map("error_message")

  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")

  aiUsageEvents AiUsageEvent[]

  @@index([siteId, startedAt])
  @@index([sessionId, startedAt])
  @@map("scan_runs")
}

// ---------------------------------------------------------------------------
// Configuration
// ---------------------------------------------------------------------------

/// An immutable snapshot of a site's runtime configuration. Publishing points
/// `Site.publishedConfigVersionId` at one of these; the row itself never
/// changes afterwards.
model ConfigVersion {
  id     String @id @default(uuid()) @db.Uuid
  siteId String @map("site_id") @db.Uuid
  site   Site   @relation("SiteConfigVersions", fields: [siteId], references: [id], onDelete: Cascade)

  version Int

  /// The exact payload the public runtime endpoint serves. Structure and
  /// selectors only — never a copy of the portfolio's content.
  runtimeConfig Json @map("runtime_config")

  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")

  publishedForSite Site?             @relation("SitePublishedConfig")
  verificationRuns VerificationRun[]

  @@unique([siteId, version])
  @@index([siteId, createdAt])
  @@map("config_versions")
}

// ---------------------------------------------------------------------------
// Installation verification
// ---------------------------------------------------------------------------

/// A single-use, short-lived challenge proving the runtime really is installed
/// on the expected origin. Only the hash is stored, so the database never holds
/// a replayable secret.
model VerificationChallenge {
  id     String @id @default(uuid()) @db.Uuid
  siteId String @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  challengeHash  String    @unique @map("challenge_hash")
  expectedOrigin String    @map("expected_origin")
  expiresAt      DateTime  @map("expires_at")
  consumedAt     DateTime? @map("consumed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  verificationRuns VerificationRun[]

  @@index([siteId, createdAt])
  @@index([expiresAt])
  @@map("verification_challenges")
}

enum VerificationOutcome {
  SUCCESS
  PARTIAL
  FAILED

  @@map("verification_outcome")
}

model VerificationRun {
  id     String @id @default(uuid()) @db.Uuid
  siteId String @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  challengeId String?                @map("challenge_id") @db.Uuid
  challenge   VerificationChallenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)

  configVersionId String?        @map("config_version_id") @db.Uuid
  configVersion   ConfigVersion? @relation(fields: [configVersionId], references: [id], onDelete: SetNull)

  runtimeVersion String? @map("runtime_version")
  reportedOrigin String? @map("reported_origin")
  reportedPath   String? @map("reported_path")

  webmcpAvailable Boolean @default(false) @map("webmcp_available")
  toolsRegistered Int     @default(0) @map("tools_registered")

  /// Per-capability live match counts, e.g. `{ "list_projects": 8 }`. Compared
  /// against the previous run to detect content changes and broken selectors.
  liveCounts Json? @map("live_counts")

  /// Structured, user-presentable diagnostics. No stack traces.
  diagnostics Json?

  /// What the browser's tool registry looked like at verification time:
  /// `{ existingTools, conflictingTools, forgeRegistered, failures }`.
  /// Stored separately from `diagnostics` because the readiness assistant and
  /// the insights panel need the raw counts, not rendered prose.
  toolRegistry Json? @map("tool_registry")

  outcome VerificationOutcome @default(FAILED)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([siteId, createdAt])
  @@map("verification_runs")
}

// ---------------------------------------------------------------------------
// AI accounting
// ---------------------------------------------------------------------------

enum AiPurpose {
  SEMANTIC_MAPPING
  NL_DEMO

  @@map("ai_purpose")
}

enum AiAttemptStatus {
  SUCCESS
  TRANSIENT_ERROR
  RATE_LIMITED
  QUOTA_EXHAUSTED
  AUTH_ERROR
  INVALID_REQUEST
  SCHEMA_INVALID
  TIMEOUT
  UNKNOWN_ERROR

  @@map("ai_attempt_status")
}

/// One Gemini request attempt. Also the server-side ledger that enforces the
/// natural-language demo question limit — a browser counter would be trivially
/// bypassed.
model AiUsageEvent {
  id String @id @default(uuid()) @db.Uuid

  siteId String? @map("site_id") @db.Uuid
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  scanRunId String?  @map("scan_run_id") @db.Uuid
  scanRun   ScanRun? @relation(fields: [scanRunId], references: [id], onDelete: SetNull)

  purpose AiPurpose
  model   String
  attempt Int             @default(1)
  status  AiAttemptStatus

  /// Coarse classification only — never the provider's raw error body.
  errorCode String? @map("error_code")
  latencyMs Int?    @map("latency_ms")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([siteId, purpose, createdAt])
  @@index([scanRunId])
  @@map("ai_usage_events")
}

// ---------------------------------------------------------------------------
// Live agent test relay
// ---------------------------------------------------------------------------

enum LiveTestStatus {
  PENDING
  READY
  CLOSED
  EXPIRED

  @@map("live_test_status")
}

/// A short-lived, origin-bound channel for executing real WebMCP tools on the
/// owner's own portfolio.
///
/// Forge cannot reach another origin's `document.modelContext`, so a genuine
/// tool call has to happen inside the target page. This session is the relay
/// that makes that possible without a browser extension — and it exists only
/// while the owner has explicitly started a test. The ordinary installed
/// runtime never polls Forge.
///
/// As with verification challenges, only the token hash is stored.
model LiveTestSession {
  id     String @id @default(uuid()) @db.Uuid
  siteId String @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  /// The builder session that started this test. A site is shared by origin,
  /// so a test must also be tied to the browser that opened it: only that
  /// session may queue commands to the connected tab, read its state or end
  /// it. Null on rows from before this column existed — those expire in
  /// minutes and match no session.
  createdBySessionId String?         @map("created_by_session_id") @db.Uuid
  createdBySession   BuilderSession? @relation(fields: [createdBySessionId], references: [id], onDelete: SetNull)

  tokenHash      String   @unique @map("token_hash")
  expectedOrigin String   @map("expected_origin")
  status         LiveTestStatus @default(PENDING)

  expiresAt DateTime  @map("expires_at")
  readyAt   DateTime? @map("ready_at")
  closedAt  DateTime? @map("closed_at")

  runtimeVersion String? @map("runtime_version")

  /// Tool names the target reported as actually visible to the browser, so
  /// routing can only choose something that genuinely exists there.
  availableTools Json? @map("available_tools")

  createdAt DateTime @default(now()) @map("created_at")

  commands LiveTestCommand[]

  @@index([siteId, createdAt])
  @@index([siteId, createdBySessionId, status])
  @@index([expiresAt])
  @@map("live_test_sessions")
}

enum LiveTestCommandStatus {
  PENDING
  DISPATCHED
  COMPLETED
  FAILED

  @@map("live_test_command_status")
}

/// One tool invocation queued for the target page.
///
/// The status column is the at-most-once guarantee: PENDING -> DISPATCHED and
/// DISPATCHED -> COMPLETED are both conditional updates, so repeated polling
/// cannot hand the same command out twice and a repeated result POST cannot
/// complete it twice.
model LiveTestCommand {
  id        String          @id @default(uuid()) @db.Uuid
  sessionId String          @map("session_id") @db.Uuid
  session   LiveTestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  /// Always a read-only capability id from the allow-list.
  tool      String
  arguments Json

  status LiveTestCommandStatus @default(PENDING)

  dispatchedAt DateTime? @map("dispatched_at")
  completedAt  DateTime? @map("completed_at")

  /// Bounded text returned by the real browser tool. Truncated before storage.
  result String?

  /// Coarse classification only; never a stack trace.
  errorCode String? @map("error_code")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([sessionId, status, createdAt])
  @@map("live_test_commands")
}
